{
	"scripts": {
		"dev": "prisma generate && node --watch --import tsx src/server.ts",
		"build": "prisma generate && tsc -p tsconfig.build.json && prisma validate",
		"start": "node dist/server.js",
		"check": "prisma generate && tsc --noEmit && prisma validate",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"dotenv": "^18.0.8",
		"express": "^5.3.0",
		"pg": "^8.23.1",
		"uuid": "^14.0.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"prisma": "^7.10.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
